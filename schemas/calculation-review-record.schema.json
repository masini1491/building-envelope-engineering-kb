{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masini1491/building-envelope-engineering-kb/schemas/calculation-review-record.schema.json",
  "title": "Calculation Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_schema_version", "review_id", "created_at", "lifecycle_status", "review_contract", "source_facts", "recalculations", "engineering_interpretations", "reconciliation_updates"],
  "properties": {
    "record_schema_version": {"type": "string", "const": "1"},
    "review_id": {"type": "string", "minLength": 1},
    "parent_review_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "lifecycle_status": {"type": "string", "enum": ["in_review", "waiting_for_input", "reconciled", "unresolved", "superseded", "closed"]},
    "review_contract": {"$ref": "#/$defs/reviewContract"},
    "source_facts": {"type": "array", "items": {"$ref": "#/$defs/sourceFact"}},
    "recalculations": {"type": "array", "items": {"$ref": "#/$defs/recalculation"}},
    "engineering_interpretations": {"type": "array", "items": {"$ref": "#/$defs/engineeringInterpretation"}},
    "reconciliation_updates": {"type": "array", "items": {"$ref": "#/$defs/reconciliationUpdate"}},
    "final_judgment": {"anyOf": [{"$ref": "#/$defs/finalJudgment"}, {"type": "null"}]}
  },
  "$defs": {
    "reviewContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "source_revision", "completion_rule"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"]},
        "completion_rule": {"type": "string", "minLength": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "design_basis_ref": {"type": ["string", "null"]}
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "source_locator", "reported_value", "units"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "reported_value": {"type": ["number", "string", "null"]},
        "units": {"type": ["string", "null"]},
        "formula": {"type": ["string", "null"]},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed_at", "check_type", "calculation_status", "comparison_status", "reported", "recomputed", "review_flags"],
      "properties": {
        "executed_at": {"type": "string", "format": "date-time"},
        "check_type": {"type": "string", "minLength": 1},
        "calculation_status": {"type": "string", "enum": ["COMPUTED", "INCOMPLETE_INPUT", "UNSUPPORTED_MODEL"]},
        "comparison_status": {"type": "string", "enum": ["MATCH", "MISMATCH", "NOT_PROVIDED", "INCOMPLETE"]},
        "reported": {"type": ["number", "string", "object", "array", "null"]},
        "recomputed": {"type": ["number", "string", "object", "array", "null"]},
        "tolerance": {"type": ["number", "object", "null"]},
        "units": {"type": ["string", "object", "null"]},
        "review_flags": {"type": "array", "items": {"type": "string"}},
        "adapter_fallback": {"type": "boolean", "default": false},
        "fallback_reason": {"type": ["string", "null"]},
        "repository_commit": {"type": ["string", "null"]}
      }
    },
    "engineeringInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpreted_at", "scope", "engineering_status", "interpretation"],
      "properties": {
        "interpreted_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1},
        "engineering_status": {"type": "string", "enum": ["PASS", "WARNING", "FAIL", "INCOMPLETE", "NOT_APPLICABLE"]},
        "interpretation": {"type": "string", "minLength": 1},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reconciliationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated_at", "new_evidence", "interpretation_change"],
      "properties": {
        "updated_at": {"type": "string", "format": "date-time"},
        "new_evidence": {"type": "string", "minLength": 1},
        "recomputation_ref": {"type": ["string", "null"]},
        "interpretation_change": {"type": "string", "minLength": 1},
        "correction_note": {"type": ["string", "null"]}
      }
    },
    "finalJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_at", "scope", "engineering_status", "root_cause_status", "disposition"],
      "properties": {
        "closed_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1},
        "engineering_status": {"type": "string", "enum": ["PASS", "WARNING", "FAIL", "INCOMPLETE", "NOT_APPLICABLE"]},
        "root_cause_status": {"type": "string", "enum": ["confirmed", "probable", "unresolved", "not_applicable"]},
        "root_cause": {"type": ["string", "null"]},
        "remaining_gaps": {"type": "array", "items": {"type": "string"}},
        "disposition": {"type": "string", "minLength": 1},
        "successor_review_id": {"type": ["string", "null"]}
      }
    }
  }
}
