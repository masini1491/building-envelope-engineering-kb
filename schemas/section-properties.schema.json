{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masini1491/building-envelope-engineering-kb/schemas/section-properties.schema.json",
  "title": "Section Properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "source", "status"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "axis_definition": {"type": ["string", "null"]},
    "principal_axis_angle_deg": {"type": ["number", "null"]},
    "centroid_x_mm": {"type": ["number", "null"]},
    "centroid_y_mm": {"type": ["number", "null"]},
    "Ix_mm4": {"type": ["number", "null"], "minimum": 0},
    "Iy_mm4": {"type": ["number", "null"], "minimum": 0},
    "Ixy_mm4": {"type": ["number", "null"]},
    "J_mm4": {"type": ["number", "null"], "minimum": 0, "description": "Torsional constant when available; do not substitute polar moment without an applicable theory basis."},
    "Cw_mm6": {"type": ["number", "null"], "minimum": 0, "description": "Warping constant when relevant to the adopted thin-walled member model."},
    "Sx_pos_mm3": {"type": ["number", "null"], "minimum": 0},
    "Sx_neg_mm3": {"type": ["number", "null"], "minimum": 0},
    "Sy_pos_mm3": {"type": ["number", "null"], "minimum": 0},
    "Sy_neg_mm3": {"type": ["number", "null"], "minimum": 0},
    "cx_pos_mm": {"type": ["number", "null"], "minimum": 0},
    "cx_neg_mm": {"type": ["number", "null"], "minimum": 0},
    "cy_pos_mm": {"type": ["number", "null"], "minimum": 0},
    "cy_neg_mm": {"type": ["number", "null"], "minimum": 0},
    "area_mm2": {"type": ["number", "null"], "minimum": 0},
    "shear_center_note": {"type": ["string", "null"]},
    "composite_action": {
      "enum": ["independent", "full_composite", "effective_properties_user_supplied", "company_validated_rule", "unknown", null]
    },
    "source": {"enum": ["estimated", "CAD", "supplier", "user", "calculated", "other"]},
    "source_note": {"type": ["string", "null"]},
    "source_revision": {"type": ["string", "null"]},
    "status": {"enum": ["provisional", "confirmed", "unknown"]}
  }
}
